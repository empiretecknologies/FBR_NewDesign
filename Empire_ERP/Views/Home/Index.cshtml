@section LinkScriptSection {
	<script type="text/javascript">
		$(function () {
			$("#fdPeriod, .fd-chart-period").each(function () {
				if ($(this).hasClass("select2-hidden-accessible")) { $(this).select2("destroy"); }
			});
			var months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
			var invoiceData = [];
			var trendData = [];
			var statusData = [];
			var pieMainStatus = "";
			var fbrErrorLogs = [];

			function pad(n) { return n < 10 ? "0" + n : n; }

			function formatDate(d) {
				return d.getDate() + " " + months[d.getMonth()] + " " + d.getFullYear();
			}

			function formatDateTime(d) {
				var h = d.getHours();
				var ampm = h >= 12 ? "PM" : "AM";
				h = h % 12;
				h = h ? h : 12;
				return formatDate(d) + " " + pad(h) + ":" + pad(d.getMinutes()) + " " + ampm;
			}

			function isoDate(d) {
				return d.getFullYear() + "-" + pad(d.getMonth() + 1) + "-" + pad(d.getDate());
			}

			function addMonths(date, monthsToAdd) {
				var d = new Date(date.getTime());
				d.setMonth(d.getMonth() + monthsToAdd);
				return d;
			}

			function getRange(period) {
				var end = new Date();
				var start = new Date();
				if (period === "day") {
					start = new Date(end.getTime());
				} else if (period === "week") {
					start.setDate(end.getDate() - 6);
				} else if (period === "month") {
					start.setMonth(end.getMonth() - 1);
					start.setDate(start.getDate() + 1);
				} else if (period === "thisMonth") {
					start = new Date(end.getFullYear(), end.getMonth(), 1);
				} else if (period === "last3") {
					start = addMonths(end, -3);
					start.setDate(start.getDate() + 1);
				} else {
					start = addMonths(end, -6);
					start.setDate(start.getDate() + 1);
				}
				return { start: start, end: end };
			}

			function formatCount(n) {
				return Number(n || 0).toLocaleString(undefined, { maximumFractionDigits: 0 });
			}

			function formatMoney(n) {
				n = Number(n || 0);
				var abs = Math.abs(n);
				if (abs >= 1000000) {
					return "PKR " + (n / 1000000).toFixed(1) + "M";
				}
				return "PKR " + n.toLocaleString(undefined, { minimumFractionDigits: 1, maximumFractionDigits: 1 });
			}

			function formatCompact(n) {
				n = Number(n || 0);
				var abs = Math.abs(n);
				if (abs >= 1000000) {
					return (n / 1000000).toFixed(1) + "M";
				}
				return n.toLocaleString(undefined, { maximumFractionDigits: 1 });
			}

			function setKpi(valueId, trendId, kpi, money) {
				kpi = kpi || {};
				$(valueId).text(money ? formatMoney(kpi.value) : formatCount(kpi.value));
				if (kpi.hasPercent) {
					var pct = Number(kpi.percent || 0);
					var up = pct >= 0;
					$(trendId).attr("class", "fd-kpi-trend " + (up ? "up" : "down"))
						.html('<i class="fa-solid fa-arrow-' + (up ? "up" : "down") + '"></i> ' + Math.abs(pct).toFixed(1) + "% vs last month")
						.show();
				} else {
					$(trendId).hide();
				}
			}

			function statusColor(label) {
				var t = (label || "").toLowerCase();
				if (t.indexOf("reject") >= 0) return "#EF4444";
				if (t.indexOf("pend") >= 0) return "#F59E0B";
				return "#22C55E";
			}

			function statusClass(label) {
				var t = (label || "").toLowerCase();
				if (t.indexOf("reject") >= 0) return "bad";
				if (t.indexOf("pend") >= 0) return "wait";
				return "ok";
			}

			function axisColors() {
				var dark = document.documentElement.getAttribute("data-theme") === "dark";
				return {
					label: dark ? "#93A7C2" : "#6B7C93",
					grid: dark ? "#22344F" : "#E7EEF7",
					text: dark ? "#E3ECF7" : "#0A2348"
				};
			}

			function renderInvoiceChart() {
				var c = axisColors();
				var options = {
					dataSource: invoiceData,
					palette: ["#2F80ED"],
					commonSeriesSettings: {
						argumentField: "month",
						type: "bar",
						color: "#2F80ED",
						ignoreEmptyPoints: true,
						barPadding: 0.45,
						label: {
							visible: true,
							backgroundColor: "none",
							font: { color: "#2F80ED", size: 11, weight: 700 },
							customizeText: function (e) {
								return Number(e.value).toLocaleString();
							}
						}
					},
					series: [{ valueField: "count", name: "Invoices" }],
					legend: { visible: false },
					tooltip: { enabled: true },
					argumentAxis: {
						label: { font: { color: c.label, size: 11 } }
					},
					valueAxis: {
						valueMarginsEnabled: true,
						maxValueMargin: 0.15,
						endOnTick: true,
						grid: { color: c.grid },
						label: { font: { color: c.label, size: 11 } }
					},
					"export": { enabled: false }
				};
				if ($("#monthlyInvoiceChart").data("dxChart")) {
					$("#monthlyInvoiceChart").dxChart("instance").option(options);
				} else {
					$("#monthlyInvoiceChart").dxChart(options);
				}
			}

			function renderTrendChart() {
				var c = axisColors();
				var options = {
					dataSource: trendData,
					commonSeriesSettings: {
						argumentField: "month",
						type: "spline",
						point: { size: 7 },
						label: {
							visible: true,
							backgroundColor: "none",
							font: { size: 10, weight: 700 },
							customizeText: function (e) {
								return formatCompact(e.value);
							}
						}
					},
					series: [
						{ valueField: "sales", name: "Sales", color: "#2F80ED" },
						{ valueField: "tax", name: "Sales Tax", color: "#22C55E" }
					],
					legend: {
						visible: true,
						verticalAlignment: "top",
						horizontalAlignment: "right",
						font: { size: 11, color: c.text }
					},
					tooltip: { enabled: true },
					argumentAxis: {
						label: { font: { color: c.label, size: 11 } }
					},
					valueAxis: {
						grid: { color: c.grid },
						label: { font: { color: c.label, size: 11 } }
					},
					"export": { enabled: false }
				};
				if ($("#salesTaxTrendChart").data("dxChart")) {
					$("#salesTaxTrendChart").dxChart("instance").option(options);
				} else {
					$("#salesTaxTrendChart").dxChart(options);
				}
			}

			function renderPieChart() {
				var options = {
					type: "pie",
					palette: statusData.map(function (x) { return statusColor(x.status); }),
					dataSource: statusData,
					legend: { visible: false },
					series: [{
						argumentField: "status",
						valueField: "value",
						label: {
							visible: true,
							position: "inside",
							backgroundColor: "none",
							font: { color: "#ffffff", size: 16, weight: 700 },
							customizeText: function (e) {
								return e.argument === pieMainStatus ? (e.percent * 100).toFixed(1) + "%" : "";
							}
						}
					}],
					tooltip: { enabled: true },
					"export": { enabled: false }
				};
				if ($("#statusPieChart").data("dxPieChart")) {
					$("#statusPieChart").dxPieChart("instance").option(options);
				} else {
					$("#statusPieChart").dxPieChart(options);
				}
			}

			function bindCharts(data) {
				data = data || {};
				invoiceData = (data.monthlyInvoiceGeneration || []).map(function (x) {
					return { month: x.label, count: x.value };
				});
				trendData = (data.salesTaxTrend || []).map(function (x) {
					return { month: x.label, sales: x.value, tax: x.value2 };
				});
				renderInvoiceChart();
				renderTrendChart();
			}

			function bindDashboard(data) {
				data = data || {};
				setKpi("#kpiInvoices", "#kpiInvoicesTrend", data.totalInvoices, false);
				setKpi("#kpiApproved", "#kpiApprovedTrend", data.fbrApproved, false);
				setKpi("#kpiPending", "#kpiPendingTrend", data.pendingInvoices, false);
				setKpi("#kpiRejected", "#kpiRejectedTrend", data.rejectedInvoices, false);
				setKpi("#kpiSales", "#kpiSalesTrend", data.totalSales, true);
				setKpi("#kpiSalesTax", "#kpiSalesTaxTrend", data.totalSalesTax, true);

				statusData = (data.invoiceStatusDistribution || []).map(function (x) {
					return { status: x.label, value: x.value };
				});

				var statusTotal = statusData.reduce(function (sum, x) { return sum + Number(x.value || 0); }, 0);
				var approved = statusData.filter(function (x) { return (x.status || "").toLowerCase().indexOf("approv") >= 0; });
				pieMainStatus = approved.length ? approved[0].status : (statusData[0] ? statusData[0].status : "");
				$("#fdStatusTotal").text(formatCount(statusTotal));
				var legendHtml = "";
				statusData.forEach(function (x) {
					var label = String(x.status || "");
					label = label.charAt(0).toUpperCase() + label.slice(1).toLowerCase();
					legendHtml += '<li><span class="fd-dot-sm" style="background:' + statusColor(x.status) + '"></span><div>' + label + '<strong>' + formatCount(x.value) + '</strong></div></li>';
				});
				$("#fdStatusLegend").html(legendHtml);

				bindMonitoring(data.fbrIntegrationMonitoring || []);
				fbrErrorLogs = data.fbrErrorLogs || [];

				var txnHtml = "";
				(data.recentTransactions || []).forEach(function (row) {
					var st = statusClass(row.fbrStatus);
					var icon = st === "bad" ? "circle-xmark" : (st === "wait" ? "clock" : "circle-check");
					txnHtml += '<tr>' +
						'<td>' + (row.invoiceNo || "") + '</td>' +
						'<td>' + (row.date || "") + '</td>' +
						'<td>' + (row.customer || "") + '</td>' +
						'<td>' + formatCount(row.amount) + '</td>' +
						'<td><span class="st ' + st + '"><i class="fa-solid fa-' + icon + '"></i> ' + (row.fbrStatus || "") + '</span></td>' +
						'<td><a class="fd-eye" href="/PurchaseBill"><i class="fa-regular fa-eye"></i></a></td>' +
						'</tr>';
				});
				$("#fdTxnBody").html(txnHtml || '<tr><td colspan="6">No transactions.</td></tr>');

				var taxHtml = "";
				var taxItems = data.taxSalesSummary || [];
				taxItems.forEach(function (item, idx) {
					var raw = String(item.value || "0");
					var num = Number(raw.replace(/,/g, ""));
					var isQty = String(item.name || "").toLowerCase().indexOf("quantity") >= 0;
					var shown = isNaN(num) || isQty ? raw : formatMoney(num);
					taxHtml += '<div class="fd-sum-item' + (idx === taxItems.length - 1 ? " total" : "") + '"><span>' + (item.name || "") + '</span><strong>' + shown + '</strong></div>';
				});
				if (taxHtml) {
					$("#fdTaxSummary").html(taxHtml);
				}

				var statsHtml = "";
				var icons = ["fa-users", "fa-file-invoice", "fa-user-check", "fa-clock"];
				(data.quickStats || []).forEach(function (item, idx) {
					statsHtml += '<div class="fd-qstat"><i class="fa-solid ' + (icons[idx] || "fa-chart-simple") + '"></i><div><span>' + (item.name || "") + '</span><strong>' + (item.value || "0") + '</strong></div></div>';
				});
				$("#fdQuickStats").html(statsHtml);

				renderPieChart();
			}

			var dashPending = 0;
			function showDashLoader() {
				dashPending++;
				$("#Loader").css("display", "flex");
			}
			function hideDashLoader() {
				dashPending--;
				if (dashPending <= 0) {
					dashPending = 0;
					$("#Loader").hide();
				}
			}

			function loadDashboard() {
				var period = $("#fdPeriod").val();
				var range = getRange(period);
				$("#fdDateRange").text(formatDate(range.start) + " - " + formatDate(range.end));
				showDashLoader();
				$.ajax({
					url: "/Home/GetDashboardData",
					type: "GET",
					data: { fromDate: isoDate(range.start), toDate: isoDate(range.end), section: "main" },
					success: function (res) {
						if (res && res.msgType === 2) {
							if (window.toastr) { toastr.error(res.msg || "Dashboard load failed"); }
							else { alert(res.msg || "Dashboard load failed"); }
						}
						bindDashboard(res && res.data ? res.data : {});
						$("#fdLastUpdated").text("Last Updated: " + formatDateTime(new Date()));
					},
					error: function () {
						if (window.toastr) { toastr.error("Dashboard load failed"); }
					},
					complete: function () {
						hideDashLoader();
					}
				});
			}

			function loadCharts() {
				var period = $(".fd-chart-period").first().val();
				var range = getRange(period);
				showDashLoader();
				$.ajax({
					url: "/Home/GetDashboardData",
					type: "GET",
					data: { fromDate: isoDate(range.start), toDate: isoDate(range.end), section: "charts" },
					success: function (res) {
						if (res && res.msgType === 2) {
							if (window.toastr) { toastr.error(res.msg || "Chart load failed"); }
							else { alert(res.msg || "Chart load failed"); }
						}
						bindCharts(res && res.data ? res.data : {});
					},
					error: function () {
						if (window.toastr) { toastr.error("Chart load failed"); }
					},
					complete: function () {
						hideDashLoader();
					}
				});
			}

			loadDashboard();
			loadCharts();

			$("#fdPeriod").on("change", function () {
				loadDashboard();
			});

			$(".fd-chart-period").on("change", function () {
				var value = $(this).val();
				$(".fd-chart-period").val(value);
				loadCharts();
			});

			$("#fdRefresh").on("click", function () {
				loadDashboard();
				loadCharts();
			});

			function findMon(items, keys) {
				for (var i = 0; i < items.length; i++) {
					var n = String(items[i].name || "").replace(/_/g, " ").toLowerCase();
					for (var k = 0; k < keys.length; k++) {
						if (n.indexOf(keys[k]) >= 0) {
							return String(items[i].value || "");
						}
					}
				}
				return "";
			}

			function bindMonitoring(items) {
				var api = findMon(items, ["api connection", "connection"]);
				var failed = findMon(items, ["failed", "fail request"]);
				var env = findMon(items, ["environment"]);
				var token = findMon(items, ["token"]);
				var last = findMon(items, ["last successful", "last sync", "successful"]);
				var time = findMon(items, ["response time", "response"]);

				$("#monApi").attr("class", "val ok").html('<i class="fa-solid fa-circle-check"></i> ' + (api || "-"));
				$("#monFailedCount").text(failed || "0");
				$("#monEnv").html('<i class="fa-solid fa-industry"></i> ' + (env || "-"));
				$("#monToken").attr("class", "val ok").html('<i class="fa-solid fa-circle-check"></i> ' + (token || "-"));
				$("#monLast").html('<i class="fa-regular fa-calendar"></i> ' + (last || "-"));
				$("#monTime").html('<i class="fa-solid fa-bolt"></i> ' + (time || "-"));
				if (env) { $("#fdEnvironment").text(env); }
				if (last) { $("#fdLastSync").text("Last Sync: " + last); }
			}

			function openErrorLogs() {
				var html = "";
				var rows = fbrErrorLogs || [];
				$("#fdErrorLogCount").text(rows.length ? (rows.length + " error" + (rows.length > 1 ? "s" : "") + " found") : "");
				if (!rows.length) {
					html = '<div class="fd-error-empty"><i class="fa-solid fa-circle-check" style="color:#22C55E;font-size:28px;display:block;margin-bottom:8px;"></i>No FBR errors in the selected period.</div>';
				} else {
					rows.forEach(function (row, idx) {
						html += '<div class="fd-error-card">' +
							'<h6><span>' + (row.invoiceNo || ("Error " + (idx + 1))) + '</span><span class="st bad">' + (row.status || "Error") + '</span></h6>' +
							'<div class="fd-error-meta">' + (row.date || "") + (row.customer ? " • " + row.customer : "") + '</div>' +
							'<div class="fd-error-msg">' + (row.error || row.status || "FBR request failed.") + '</div>' +
							'</div>';
					});
				}
				$("#fdErrorLogList").html(html);
				var modal = bootstrap.Modal.getOrCreateInstance(document.getElementById("fdErrorLogModal"));
				modal.show();
			}

			$("#fdViewErrorLogs, #fdQuickErrorLogs").on("click", function (e) {
				e.preventDefault();
				openErrorLogs();
			});

			$("#erpDashSettings").on("click", function (e) {
				e.preventDefault();
				if (window.empr_Profile && typeof empr_Profile.open === "function") {
					empr_Profile.open();
				} else {
					$("#erpMenuProfile").trigger("click");
				}
			});

			new MutationObserver(function () {
				renderInvoiceChart();
				renderTrendChart();
				renderPieChart();
			}).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });

			$(window).on("resize", function () {
				if ($("#monthlyInvoiceChart").data("dxChart")) { $("#monthlyInvoiceChart").dxChart("render"); }
				if ($("#salesTaxTrendChart").data("dxChart")) { $("#salesTaxTrendChart").dxChart("render"); }
				if ($("#statusPieChart").data("dxPieChart")) { $("#statusPieChart").dxPieChart("render"); }
			});
		});
	</script>
}
