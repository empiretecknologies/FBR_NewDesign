<style>
    .Record .dx-selectbox.dx-texteditor {
        height: 36px !important;
        min-height: 36px !important;
        overflow: hidden;
        display: flex !important;
        align-items: center !important;
    }

    .Record .dx-selectbox .dx-texteditor-container,
    .Record .dx-selectbox .dx-texteditor-input-container {
        height: 100% !important;
        min-height: 0 !important;
        background: transparent !important;
        display: flex !important;
        align-items: center !important;
    }

    .Record .dx-selectbox .dx-texteditor-input {
        height: 100% !important;
        min-height: 0 !important;
        padding: 0 12px !important;
        color: #0A2348 !important;
        font-size: 12.5px !important;
        line-height: 34px !important;
    }

    .Record .dx-selectbox .dx-texteditor-buttons-container {
        height: 100% !important;
        align-items: center !important;
    }

    .Record .dx-selectbox .dx-placeholder {
        top: 0 !important;
        bottom: 0 !important;
        height: 100% !important;
        transform: none !important;
    }

    .Record .dx-selectbox .dx-placeholder.dx-state-invisible,
    .Record .dx-selectbox:not(.dx-texteditor-empty) .dx-placeholder {
        display: none !important;
    }

        .Record .dx-selectbox .dx-placeholder::before {
            padding: 0 12px !important;
            font-size: 12.5px !important;
            line-height: 1.3 !important;
        }

    .qs-grid-card {
        border: 1px solid #dbe6f2;
        border-radius: 12px;
        overflow: hidden;
    }

    #gridContainer .dx-datagrid {
        border: 0;
        color: #0A2348;
    }

    #gridContainer .dx-datagrid-header-panel {
        padding: 10px 12px 6px;
        border-bottom: 0;
        background: #ffffff;
    }

        #gridContainer .dx-datagrid-header-panel .dx-group-panel-message {
            color: #8aa0b8;
            font-size: 12px;
        }

        #gridContainer .dx-datagrid-header-panel .dx-button {
            border: 1px solid #dbe4ee;
            border-radius: 6px;
            background: #ffffff;
        }

            #gridContainer .dx-datagrid-header-panel .dx-button .dx-icon {
                color: #0E3A70 !important;
            }

        #gridContainer .dx-datagrid-header-panel .dx-searchbox.dx-texteditor {
            border: 1px solid #dbe4ee !important;
            border-radius: 6px !important;
            background: #eef3f8 !important;
        }

    #gridContainer .dx-datagrid-headers,
    #gridContainer .dx-datagrid-headers .dx-header-row,
    #gridContainer .dx-datagrid-headers .dx-header-row > td {
        background: #0F3F7A !important;
        color: #ffffff !important;
    }

        #gridContainer .dx-datagrid-headers .dx-header-row > td {
            padding-top: 10px !important;
            padding-bottom: 10px !important;
            border-color: rgba(255, 255, 255, 0.14) !important;
            font-size: 12.5px !important;
            font-weight: 600;
        }

            #gridContainer .dx-datagrid-headers .dx-header-row > td .dx-header-filter,
            #gridContainer .dx-datagrid-headers .dx-header-row > td .dx-sort,
            #gridContainer .dx-datagrid-headers .dx-header-row > td .dx-icon {
                color: rgba(255, 255, 255, 0.75) !important;
            }

        #gridContainer .dx-datagrid-headers .dx-datagrid-filter-row,
        #gridContainer .dx-datagrid-headers .dx-datagrid-filter-row > td {
            background: #eef3f8 !important;
            border-color: #dbe4ee !important;
        }

            #gridContainer .dx-datagrid-headers .dx-datagrid-filter-row .dx-texteditor {
                border: 1px solid #dbe4ee !important;
                border-radius: 5px !important;
                background: #ffffff !important;
            }

            #gridContainer .dx-datagrid-headers .dx-datagrid-filter-row .dx-icon {
                color: #5A7394 !important;
            }

    #gridContainer .dx-datagrid-rowsview .dx-row > td {
        padding-top: 8px !important;
        padding-bottom: 8px !important;
        border-color: #e7eef7 !important;
        color: #0A2348;
        font-size: 12.5px;
    }

    #gridContainer .dx-datagrid-rowsview .dx-row-alt > td {
        background-color: #f7faff;
    }

    #gridContainer .dx-datagrid-rowsview .dx-data-row.dx-state-hover:not(.dx-selection) > td {
        background-color: #eaf2fc !important;
    }

    #gridContainer .dx-datagrid-rowsview .dx-selection.dx-row > td {
        background-color: #154C93 !important;
        color: #ffffff !important;
    }

    #gridContainer .dx-datagrid-rowsview .dx-data-row a,
    #gridContainer .dx-datagrid-rowsview .dx-data-row i {
        color: #154C93;
    }

    #gridContainer .dx-datagrid-rowsview .dx-selection.dx-row a,
    #gridContainer .dx-datagrid-rowsview .dx-selection.dx-row i {
        color: #ffffff;
    }

    #gridContainer .dx-datagrid-pager {
        padding: 10px 12px;
        border-top: 1px solid #e7eef7;
        background: #ffffff;
    }

        #gridContainer .dx-datagrid-pager .dx-page,
        #gridContainer .dx-datagrid-pager .dx-page-size {
            min-width: 28px;
            padding: 5px 8px;
            border-radius: 6px;
            color: #0E3A70;
            font-size: 12px;
            font-weight: 600;
            text-align: center;
        }

            #gridContainer .dx-datagrid-pager .dx-page:hover,
            #gridContainer .dx-datagrid-pager .dx-page-size:hover {
                background: #eaf2fc;
            }

            #gridContainer .dx-datagrid-pager .dx-page.dx-selection,
            #gridContainer .dx-datagrid-pager .dx-page-size.dx-selection {
                background: #0E3A70 !important;
                color: #ffffff !important;
            }

        #gridContainer .dx-datagrid-pager .dx-navigate-button {
            color: #0E3A70;
        }

        #gridContainer .dx-datagrid-pager .dx-info {
            color: #5A7394;
            font-size: 12px;
            opacity: 1;
        }
</style>

<div class="card">
    <div class="card-header">
        <button type="button" id="BtnNew" style="display:none" class="btn btn-primary btn-new waves-effect waves-light float-end"><i class="fa fa-plus"></i> Add New</button>
    </div>
    <div class="card-body Record">
        <div class="row">
            <div class="col-xl-2">
                <label class="form-label" for="Code">Code:</label>
                <input class="form-control" id="Code" readonly type="text" autocomplete="off">
            </div>
            <div class="col-xl-2">
                <label class="form-label" for="ASTATUS">Status:</label>
                <div id="ASTATUS"></div>
            </div>
            <div class="col-xl-4 mb-1">
                <label class="form-label" for="GROUP_NAME">Name:</label>
                <input class="form-control" id="GROUP_NAME" type="text" autocomplete="off">
            </div>
            <div class="col-xl-4 mb-1">
                <label class="form-label" for="Quantity">Quantity:</label>
                <input class="form-control" id="QTY" type="text" autocomplete="off">
            </div>
            <span class="span name-validation"></span>
            <div class="col-xl-12 text-end">
                <button class="btn btn-danger btn-delete" style="display:none" id="BtnDelete"><i class="fa fa-trash"></i> Delete</button>
                <button class="btn btn-primary btn-save" id="BtnSave"><i class="fa fa-save"></i> Save</button>
            </div>
        </div>
    </div>
    <div class="card-body pt-0">
        <div class="table-responsive qs-grid-card">
            <div id="gridContainer"></div>
        </div>
    </div>
</div>
@section LinkScriptSection{
    <script type="text/javascript">
        var Permissions = @Html.Raw(Json.Serialize(ViewBag.Permissions));
    </script>
    <script src="~/js/customjs/empr_SetupType.js" asp-append-version="true"></script>
    <script type="text/javascript">
        $(function () {
            empr_SetupType.initEvents();
        });
    </script>
}