}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />
    <title> @ViewBag.WebsiteName</title>
    <script>
        window.erpUserId = @Html.Raw(Json.Serialize(Context.Session.GetString("Id") ?? ""));
        (function () {
            var theme = localStorage.getItem('erpTheme_' + window.erpUserId) === 'dark' ? 'dark' : 'light';
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>
    <link rel="shortcut icon" href="~/images/empire-logo.png" />
    @* <link rel="shortcut icon" href="~/images/Favicon.png" /> *@
    <environment>
        <link href="~/css/bootstrap.min.css" rel="stylesheet">

        <!-- font-family: 'Poppins', sans-serif; -->
        <link rel="stylesheet" href="~/css/poppins-font.css" />

        <!-- font awesome -->
        <link rel="stylesheet" href="~/css/font-awesome-all.css" />

        <!-- themify-icons -->
        <link rel="stylesheet" href="~/css/themify-icons.css" />

        <!-- icofont-icons -->
        <link rel="stylesheet" href="~/css/icofont.css">
        <!-- dev extreme -->
        <!-- ImportantLinks-->
        <link href="~/css/vendors/toastr.css" rel="stylesheet" asp-append-version="true" />
        <link href="~/css/vendors/sweetalert2.min.css" rel="stylesheet" asp-append-version="true" />
        <link rel="stylesheet" type="text/css" href="~/css/vendors/datatables.css" asp-append-version="true" />
        <!-- select2 -->
        <link href="~/css/select2.min.css" rel="stylesheet" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/dx.common.css" asp-append-version="true">
        <link rel="stylesheet" href="~/css/dx.generic.custom-scheme.css" asp-append-version="true">
        <!-- choices js -->
        <!-- main -->
        <link href="~/css/main.css" rel="stylesheet" asp-append-version="true">
        <!-- mtstyle -->
        <link href="~/css/mtstyles.css" rel="stylesheet" asp-append-version="true">
        <link href="~/css/tautocomplete.css" rel="stylesheet" asp-append-version="true">
        <!-- Custom styles for this template -->
        <link href="~/css/style.css" rel="stylesheet" asp-append-version="true">
        <link href="~/css/app-theme.css" rel="stylesheet" asp-append-version="true">
        <link href="~/css/posstyle.css" rel="stylesheet" asp-append-version="true">
        @*<link rel="stylesheet" href="https://code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">*@
        <link href="~/lib/toast-notification/build/toastr.css" rel="stylesheet" />
        <link rel="stylesheet" href="~/css/DatePicker.css" />

        <link href="~/lib/toast-notification/build/toastr.min.css" rel="stylesheet" />
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/croppie/2.6.5/croppie.css" integrity="sha512-2eMmukTZtvwlfQoG8ztapwAH5fXaQBzaMqdljLopRSA0i6YKM8kBAOrSSykxu9NN9HrtD45lIqfONLII2AFL/Q==" crossorigin="anonymous" referrerpolicy="no-referrer" />
        <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
        @* <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.0/signalr.min.js"></script> *@
        <script src="https://cdn.jsdelivr.net/npm/qz-tray/qz-tray.js"></script>
        <style>
            @@import url('https://fonts.googleapis.com/css?family=Roboto:100,300,400,500,700,900&display=swap');

            .dx-datagrid .dx-data-row > td.bullet {
                padding-top: 0;
                padding-bottom: 0;
            }

            #Loader {
                display: none;
                position: fixed;
                inset: 0;
                z-index: 99999;
                width: 100%;
                height: 100%;
            }

            #form .dx-fieldset {
                height: 500px;
            }

            .hide {
                display: none !important;
            }

            .span {
                color: red;
                font-size: 9px;
            }

            input::-webkit-outer-spin-button,
            input::-webkit-inner-spin-button {
                display: none;
            }

            /* .dx-toolbar-label .dx-toolbar-item-content > div {
                                                                overflow: hidden;
                                                                text-overflow: ellipsis;
                                                                white-space: nowrap;
                                                                display: none;
                                                            } */

            .form-control,
            .form-select {
                font-size: 11px;
                padding: 2px 10px;
                box-shadow: inherit !important;
            }

            label.form-label {
                font-size: 10px;
                margin-bottom: 3px;
                font-weight: 600;
            }

            textarea.form-control {
                min-height: calc(0.5em + 0.75rem + 2px);
            }

            .nav-link {
                display: block;
                padding: 0.2rem 1rem;
                color: #0d6efd;
                text-decoration: none;
                transition: color .15s ease-in-out, background-color .15s ease-in-out, border-color .15s ease-in-out;
            }

            .table {
                overflow-y: auto;
            }

            .dx-group-panel-message {
                z-index: 9999999;
            }

            .nav-tabs li.nav-item .nav-link {
                font-size: 10px;
                border-radius: 0 !important;
            }

            ul.ui-widget {
                font-size: 13px;
                border: 0;
            }

                ul.ui-widget li.ui-menu-item {
                    list-style-image: none;
                    font-family: "Helvetica Neue", HelveticaNeue, helvetica, arial, sans-serif;
                    font-size: 92%;
                    font-weight: 300;
                    font-style: normal;
                    font-size-adjust: none;
                    margin: 0;
                    padding: 1.8px 4.55px;
                    white-space: nowrap;
                }

            .ui-widget-content a {
                color: #444444;
            }



            ul.ui-widget li.ui-menu-item b {
                font-weight: 700;
            }

            #search {
                height: 25px;
            }

            .ui-widget-content .ui-state-focus {
                background-color: #D6F7FF;
                background-image: none;
                border: 0;
            }

            .highlight {
                background-color: #1A73C7;
                color: #fff;
            }

            a,
            a:hover {
                text-decoration: none;
            }

            body {
                font-family: 'Roboto', sans-serif;
            }

            /*------------------  */
            .ci-user-picture {
                min-width: 150px;
                margin-right: 16px;
            }

                .ci-user-picture img {
                    width: 150px;
                    height: 150px;
                    border-radius: 50%;
                }

            .filepreviewprofile {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                opacity: 0;
            }

            /*----modal--------*/
            .modal-header-bg {
                width: 100%;
                height: 12px;
                background: #1A73C7;
            }

            .cropImageModal .modal-dialog {
                max-width: 750px;
                width: 90%;
                margin: 0.5rem auto;
            }

            .up-photo-title {
                padding: 8px 15px;
                text-align: center;
            }

            #upload-demo {
                position: relative;
                width: 100%;
                height: 250px;
                padding-bottom: 0;
            }

            .croppie-container h5 {
                position: absolute;
                bottom: 4px;
                text-align: center;
                left: 0;
                right: 0;
                color: #fff;
                z-index: 2;
                font-size: 15px;
            }

            figure figcaption {
                position: absolute;
                bottom: 0;
                color: #fff;
                width: 100%;
                padding-left: 9px;
                padding-bottom: 5px;
                text-shadow: 0 0 10px #000;
            }

            .croppie-container .cr-image {
                right: 0;
            }

            .croppie-container .cr-slider-wrap {
                width: 275px;
            }

            .cr-slider-wrap p {
                font-size: 13px;
                color: #8D8D94;
                text-align: left;
            }

            .cr-slider {
                width: 275px;
            }

            .upload-action-btn {
                margin-top: 60px;
                padding-top: 40px;
            }

            .cr-slider::-webkit-slider-thumb {
                -webkit-appearance: none;
                appearance: none;
                width: 18px;
                height: 18px;
                background: #006AFA;
                cursor: pointer;
                box-shadow: 0px 0px 12px rgba(0, 0, 0, 0.25);
            }

            .cr-slider::-moz-range-thumb {
                width: 18px;
                height: 18px;
                background: #006AFA;
                cursor: pointer;
                box-shadow: 0px 0px 12px rgba(0, 0, 0, 0.25);
            }

            .cr-slider::-ms-thumb {
                width: 18px;
                height: 18px;
                background: #006AFA;
                cursor: pointer;
                box-shadow: 0px 0px 12px rgba(0, 0, 0, 0.25);
            }

            .cr-slider::-webkit-slider-runnable-track {
                width: 275px;
                height: 2px;
                cursor: pointer;
                box-shadow: none;
                background: #E0E0E0;
                border-radius: 3px;
                border: none;
            }

            .cr-slider:focus::-webkit-slider-runnable-track {
                background: #E0E0E0;
            }

            .cr-slider::-moz-range-track {
                width: 275px;
                height: 2px;
                cursor: pointer;
                box-shadow: none;
                background: #E0E0E0;
                border-radius: 3px;
                border: none;
            }

            .cr-slider::-ms-track {
                width: 275px;
                height: 2px;
                cursor: pointer;
                box-shadow: none;
                background: #E0E0E0;
                border-radius: 3px;
                border: none;
                color: transparent;
            }

            #ui-datepicker-div {
                position: fixed;
                top: 268.75px;
                left: 308px;
                z-index: 1000;
                display: block;
            }

            /* start */

            .dropdown-submenu > .dropdown-menu {
                display: none;
                position: absolute;
                top: 0;
                left: 100%;
                min-width: 330px !important; /* 🔥 Force width */
                width: 400px !important; /* 🔥 Force apply width */
                z-index: 9999;
                max-height: 400px; /* 500px ke baad scroll start hoga */
                overflow-y: auto; /* vertical scrollbar enable */
                overflow-x: hidden;
            }

            .dropdown-submenu:hover > .dropdown-menu {
                display: block;
            }

            .dropdown-submenu > .dropdown-menu {
                z-index: 9999;
            }

            .dropdown-toggle::after {
                display: none !important;
            }

            .dropdown-menu .dropdown-item {
                padding-top: 5px;
                padding-bottom: 5px;
                line-height: 1.2;
            }

            .dropdown-menu {
                position: absolute; /* ya fixed, use-case ke hisaab se */
                z-index: 9999; /* sab se upar laane ke liye bada z-index */
            }

            .favMenu.highlight {
                border: 2px dashed #4caf50;
                background-color: rgba(76, 175, 80, 0.1);
                transition: all 0.2s ease-in-out;
            }

            .slide-track-custom {
                background-color: #1A73C7;
                clip-path: polygon(20px 0%, 100% 0%, 100% 100%, 0% 100%);
                color: white;
                overflow: hidden;
                display: inline-block;
                padding: 3px 12px;
            }


            .branch-name-custom {
                color: white !important;
                white-space: nowrap !important;
                font-size: 11px !important;
                letter-spacing: 1px !important;
                visibility: visible !important;
            }

            /* breadcrumb */

            .breadcrumb-box {
                text-align: left;
            }

            .breadcrumb-custom {
                background-color: #1A73C7;
                /* clip-path: polygon(0% 0%, 100% 0%, 90% 100%, 0px 100%); */
                clip-path: polygon(0px 0px, 100% 0%, calc(100% - 20px) 100%, 0px 100%);
                color: white;
                overflow: hidden;
                display: inline-block;
                padding: 7px 40px 0px 12px;
                margin: 0;
            }

                .breadcrumb-custom li {
                    color: white;
                    font-size: 11px;
                    letter-spacing: 1px;
                    white-space: nowrap;
                }

                .breadcrumb-custom a {
                    color: white;
                    text-decoration: none;
                }

            /* KnockOff modal */
            .modal-dialog.knockoff-modal {
                max-width: 60%;
                width: 95%;
                height: 75%; /* Add this */
                margin: 0 auto; /* Center vertically */
                margin-top: 3rem; /* Center vertically */
            }

            .modal-content {
                height: 100%; /* Add this */
                display: flex;
                flex-direction: column;
            }

            #knockOffModal .modal-body {
                overflow-y: auto;
                flex: 1; /* This will make modal-body take remaining space */
            }

            .dx-revert-button {
                display: none !important;
            }

            .gear-dropdown {
                display: none;
                position: absolute !important;
                background: #fff;
                border: 1px solid #ddd;
                border-radius: 8px;
                padding: 15px 20px;
                width: 240px !important;
                max-width: 350px;
                z-index: 9999;
                box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15); /* Softer, larger shadow */
                transition: opacity 0.2s ease, transform 0.2s ease;
                /* opacity: 0; /* start hidden */ */ transform: translateY(-10px); /* slight upward offset for animation */
            }


                .gear-dropdown .form-check {
                    padding-left: 0;
                }

                .gear-dropdown .form-check-label {
                    margin-left: 0.5rem;
                }

            .breadcrumb-box, .breadcrumb {
                overflow: visible !important; /* ensure dropdown is visible */
            }

            .dclear-chk {
                margin-left: 4.5em !important;
            }


            .gear-checkbox {
                width: 13px;
                height: 13px;
                transform: scale(1.3);
                margin-left: 1.1em;
                accent-color: var(--theme-deafult);
                cursor: pointer;
            }

            .negative-summary {
                color: red;
                font-weight: 600;
            }


            #DetailCharges {
                z-index: 1056 !important;
            }

        </style>
    </environment>
    @if (IsSectionDefined("LinkStyleSection"))
    {
        @RenderSection("LinkStyleSection")
        ;
    }
    @if (IsSectionDefined("InLineStyleSection"))
    {
        @RenderSection("InLineStyleSection")
        ;
    }
</head>

<body class="full_width">
    <div class="loader-box" id="Loader">
        <div class="erp-loader-card">
            <div class="loader-1"></div>
        </div>
    </div>
    @{
        string navKey = Convert.ToString(ViewBag.NavKey) ?? "";
        string pageGroup = Convert.ToString(ViewBag.PageGroup) ?? "";
        bool openTransactions = pageGroup == "Transactions";
        bool openReports = pageGroup == "Reports";
        bool openSetup = pageGroup == "Setup";
        bool openSettings = pageGroup == "Settings";
    }
    <div class="erp-shell" id="erpShell">
        <aside class="erp-sidebar">
            <div class="erp-brand">
                <img class="erp-brand-logo erp-brand-logo-full" src="~/images/empire-logo-white.png" alt="Empire Technologies" />
                <img class="erp-brand-logo erp-brand-logo-mark" src="~/images/empire-mark.png" alt="Empire Technologies" />
            </div>
            <nav class="erp-nav">
                <a class="erp-nav-item @(navKey == "dashboard" ? "active" : "")" href="/Home" title="Dashboard">
                    <i class="fa-solid fa-house"></i><span>Dashboard</span>
                </a>
                <div class="erp-nav-group open @(openTransactions ? "active-group" : "")">
                    <button type="button" class="erp-nav-item erp-nav-toggle" title="Transactions">
                        <span><i class="fa-solid fa-right-left"></i><span>Transactions</span></span>
                        <i class="fa-solid fa-chevron-down erp-caret"></i>
                    </button>
                    <div class="erp-subnav" data-title="Transactions">
                        <a class="@(navKey == "purchase-bill" ? "active" : "")" href="/PurchaseBill" title="Sales Tax Invoice">Sales Tax Invoice</a>
                    </div>
                </div>
                <div class="erp-nav-group open @(openReports ? "active-group" : "")">
                    <button type="button" class="erp-nav-item erp-nav-toggle" title="Reports">
                        <span><i class="fa-solid fa-chart-column"></i><span>Reports</span></span>
                        <i class="fa-solid fa-chevron-down erp-caret"></i>
                    </button>
                    <div class="erp-subnav" data-title="Reports">
                        <a class="@(navKey == "sales-tax-invoice-report" ? "active" : "")" href="/SalesInvoiceReport" title="Sales Tax Invoice Report">Sales Tax Invoice Report</a>
                    </div>
                </div>
                <div class="erp-nav-group open @(openSetup ? "active-group" : "")">
                    <button type="button" class="erp-nav-item erp-nav-toggle" title="Setup">
                        <span><i class="fa-solid fa-gears"></i><span>Setup</span></span>
                        <i class="fa-solid fa-chevron-down erp-caret"></i>
                    </button>
                    <div class="erp-subnav" data-title="Setup">
                        <a class="@(navKey == "customer" ? "active" : "")" href="/PartyTypes" title="Customer">Customer</a>
                        <a class="@(navKey == "item-master" ? "active" : "")" href="/ItemMaster" title="Item Master">Item Master</a>
                        <a class="@(navKey == "unit-of-measure" ? "active" : "")" href="/SetupType" title="Unit of Measure">Unit of Measure</a>
                    </div>
                </div>
                <div class="erp-nav-group open @(openSettings ? "active-group" : "")">
                    <button type="button" class="erp-nav-item erp-nav-toggle" title="Settings">
                        <span><i class="fa-solid fa-user-gear"></i><span>Settings</span></span>
                        <i class="fa-solid fa-chevron-down erp-caret"></i>
                    </button>
                    <div class="erp-subnav" data-title="Settings">
                        <a class="@(navKey == "user-management" ? "active" : "")" href="/User" title="User Management">User Management</a>
                        <a class="@(navKey == "database-backup" ? "active" : "")" href="/DatabaseBackup" title="Database Backup">Database Backup</a>
                        <a href="javascript:;" id="erpSideProfile" title="My Profile">My Profile</a>
                        <a href="javascript:;" onclick="Logout()" title="Logout">Logout</a>
                    </div>
                </div>
            </nav>
            <img class="erp-sidebar-city" src="~/images/erp-city.svg" alt="" />
            <div class="erp-sidebar-foot">
                <span>Empowering Business</span>
                <span>with Smart Solutions</span>
                <a class="erp-sidebar-link" href="https://empiretecknologies.com" target="_blank" rel="noopener noreferrer">empiretecknologies.com</a>
                <small>v7.0.0</small>
            </div>
        </aside>
        <div class="erp-sidebar-backdrop" id="erpSidebarBackdrop"></div>
        <div class="erp-main">
            <div class="erp-topbar">
                <div class="erp-topbar-left">
                    <button type="button" class="erp-menu-btn" title="Toggle menu"><i class="fa-solid fa-bars"></i></button>
                </div>
                <div class="erp-topbar-right">
                    <div class="erp-chip"><i class="fa-solid fa-building"></i><span>@ViewBag.Company</span></div>
                    <div class="erp-chip"><i class="fa-solid fa-location-dot"></i><span>@ViewBag.BranchForNav</span></div>
                    <div class="erp-chip"><i class="fa-regular fa-calendar"></i><span>@ViewBag.Period</span></div>
                    <a href="javascript:;" class="erp-user" id="erpUserBtn" title="My Profile">
                        <img id="erpUserImg" src="@ViewBag.ProfileImage" alt="" onerror="this.onerror=null;this.src='/images/img-user.jpg';">
                        <span id="erpUserName">@ViewBag.Name</span>
                    </a>
                    <div class="dropdown erp-settings">
                        <button type="button" class="erp-settings-btn" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" title="Settings">
                            <i class="fa-solid fa-gear"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end erp-settings-menu">
                            <li class="erp-settings-title">Settings</li>
                            <li><a href="/User" class="erp-settings-item"><i class="fa-solid fa-users-gear"></i><span>User Management</span></a></li>
                            <li><a href="/DatabaseBackup" class="erp-settings-item"><i class="fa-solid fa-database"></i><span>Database Backup</span></a></li>
                            <li><a href="javascript:;" class="erp-settings-item" id="erpMenuProfile"><i class="fa-solid fa-user-pen"></i><span>My Profile</span></a></li>
                            <li>
                                <div class="erp-settings-item erp-theme-row">
                                    <i class="fa-solid fa-circle-half-stroke"></i><span>Dark Mode</span>
                                    <div class="form-check form-switch m-0 ms-auto">
                                        <input class="form-check-input" type="checkbox" role="switch" id="erpThemeSwitch">
                                    </div>
                                </div>
                            </li>
                            <li><a href="javascript:;" class="erp-settings-item" onclick="StopIIS()"><i class="fa-solid fa-power-off"></i><span>Stop IIS</span></a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a href="javascript:;" class="erp-settings-item erp-settings-logout" onclick="Logout()"><i class="fa-solid fa-right-from-bracket"></i><span>Logout</span></a></li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="erp-canvas">
                <div class="erp-workspace">
                    <div class="erp-crumb">
                        @Html.Raw(ViewBag.BreadCrumbHTML)
                    </div>
                    <div class="container-fluid">
                    <div id="gearDropdown" class="gear-dropdown">
                        <div class="fw-bold mb-2 ms-0"><i style="color:#1A73C7;" class='fa-solid fa-gear'></i> Settings</div>
                        <div class="mb-2 d-flex align-items-center justify-content-between" style="white-space: nowrap;">
                            <label class="form-check-label" for="g2">  Row  Limit : </label>
                            <input type="number" style="width:30%;" type="text" id="RowLimit" min="1" step="1" class="form-control mb-2">
                        </div>
                        <div class="form-check form-switch mb-2 d-flex  align-items-center">
                            <label class="form-check-label" for="g2">Data Clear :</label>
                            <input class="mb-3 form-check-input dclear-chk" id="DClear-ChkBox" type="checkbox">
                        </div>
                        <div class="form-check form-switch mb-2 align-items-center">
                            <label class="form-check-label" for="g1">Search With Detail : </label>
                            <input class="gear-checkbox" id="Search-Chkbox" type="checkbox">
                        </div>
                        <div class="text-end">
                            <button id="BtnApply" class="btn btn-sm btn-primary w-40">Apply</button>
                        </div>
                    </div>
                    @RenderBody()
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container" style="display:none">
        <div class="row">
            <div class="col-md-12">
                <div class="form-group">
                    <div class="confirm-identity">
                        <div class="ci-user d-flex align-items-center justify-content-center">
                            <div class="ci-user-picture">
                                <img src="https://image.flaticon.com/icons/svg/145/145867.svg" id="item-img-output" class="imgpreviewPrf img-fluid" alt="">
                            </div>
                        </div>
                        <div class="ci-user-btn text-center mt-4">
                            <a href="javascript:;" class="userEditeBtn btn-default bg-blue position-relative">
                                <input type="file" class="item-img file center-block filepreviewprofile">
                                Adjust Image
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade cropImageModal" id="cropImagePop" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
        <button type="button" class="close-modal-custom" data-dismiss="modal" aria-label="Close"><i class="feather icon-x"></i></button>
        <div class="modal-dialog">
            <div class="modal-content">
