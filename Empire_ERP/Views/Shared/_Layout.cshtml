@{
    string logoutURL = ViewBag.WebsiteURL + "/login/logout";
    string favIcon = Context.Session.GetString("Icon");
    string logo = Context.Session.GetString("Logo");
    // string profileURL = ViewBag.WebsiteURL + "home/profile";
