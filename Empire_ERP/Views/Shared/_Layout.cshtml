                    document.getElementById('myTab')?.addEventListener(
                'keydown',
                blockArrowKeys,
                true
            );

            document.querySelectorAll('.my-tabsss').forEach(function (el) {
                el.addEventListener(
                    'keydown',
                    blockArrowKeys,
                    true
                );
            });
            function blockArrowKeys(e) {
                if (
                    e.key === 'ArrowLeft' ||
                    e.key === 'ArrowRight' ||
                    e.key === 'ArrowUp' ||
                    e.key === 'ArrowDown'
                ) {
                    e.preventDefault();
                    e.stopPropagation();
                    e.stopImmediatePropagation();
                    return false;
                }
            }

